#!/usr/bin/env bash
set -u
HERE="$(realpath .)"
echo "Entering sandbox for $HERE"
exec bwrap \
  --ro-bind /usr /usr --symlink usr/bin /bin \
  --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
  --ro-bind /etc /etc --proc /proc --dev /dev \
  --tmpfs /tmp \
  --ro-bind "$HOME/.pi/agent/npm" "$HOME/.pi/agent/npm" \
  --ro-bind-try "$HOME/.pi/agent/auth.json" "$HOME/.pi/agent/auth.json" \
  --ro-bind-try "$HOME/.pi/agent/settings.json" "$HOME/.pi/agent/settings.json" \
  --bind-try "$HOME/.pi/agent/extensions" "$HOME/.pi/agent/extensions" \
  --bind-try "$HOME/.pi/agent/sessions" "$HOME/.pi/agent/sessions" \
  --bind "$HERE" "$HERE" \
  --ro-bind "$HOME/.pi/agent/bin" "$HOME/.pi/agent/bin" \
  --ro-bind "$HOME/.pi/agent/install" "$HOME/.pi/agent/install" \
  --ro-bind-try "${XDG_DATA_HOME:-$HOME/.local/share}/pi-node" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/pi-node" \
  --ro-bind-try "$HOME/.gitconfig" "$HOME/.gitconfig" \
  --ro-bind-try "$HOME/.config/nvim" "$HOME/.config/nvim" \
  --bind-try "$HOME/.local/share/nvim" "$HOME/.local/share/nvim" \
  --bind-try "$HOME/.local/state/nvim" "$HOME/.local/state/nvim" \
  --bind-try "$HOME/.cache/nvim" "$HOME/.cache/nvim" \
  --unshare-pid --unshare-uts --unshare-ipc --die-with-parent --new-session \
  --clearenv \
  --setenv PATH "/usr/bin:/bin" \
  --setenv HOME "$HOME" \
  --setenv TERM "${TERM:-xterm-256color}" \
  --chdir "$HERE" \
  -- "$HOME/.pi/agent/bin/pi" "$@"
